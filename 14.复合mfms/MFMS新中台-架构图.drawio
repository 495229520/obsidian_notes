  <diagram name="MFMS v0.4 系统架构与数据链路总览" id="mfms-v04-graphic-arch">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="MFMS 系统架构与数据流向总览 v0.4（中台需求 · 调度订单/运单 · 下位机控制权）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="35" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="【v0.4 架构基线】中台单写需求；调度拆分并单写订单/运单；中台只读派生表；下位机独占控制权裁决" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1080" height="25" as="geometry"/></mxCell>
        <mxCell id="box_legend" value="&lt;b style=&quot;font-size:11.5px;color:#1E293B;&quot;&gt;图例 · 数据流向&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#1E40AF;font-weight:700;&quot;&gt;── 实线蓝&lt;/span&gt;：业务需求 / 查询请求 (下行)&lt;br&gt;&lt;span style=&quot;color:#B91C1C;font-weight:700;&quot;&gt;── 实线红&lt;/span&gt;：控制权申请 / 调试指令 (下行调用)&lt;br&gt;&lt;span style=&quot;color:#047857;font-weight:700;&quot;&gt;┅┅ 虚线绿&lt;/span&gt;：Stream 实时状态 / 遥测事实 (上行推送)&lt;br&gt;&lt;span style=&quot;color:#D97706;font-weight:700;&quot;&gt;┅┅ 虚线橙&lt;/span&gt;：MySQL 持久化 (职责单写)&lt;br&gt;&lt;span style=&quot;color:#6B21A8;font-weight:700;&quot;&gt;── 实线紫&lt;/span&gt;：调度系统运单下发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontSize=10.5;align=left;spacingLeft=12;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1540" y="20" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="box_l5_l6" value="L5 / L6 上位应用与工厂系统 (Client &amp; Site Layer)" style="swimlane;html=1;startSize=26;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;fontStyle=1;fontColor=#334155;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="1470" height="95" as="geometry"/></mxCell>
        <mxCell id="c_mes" value="&lt;b&gt;MES / SCADA 系统&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;生产工单 / 批量派单&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11.5;" vertex="1" parent="box_l5_l6"><mxGeometry x="20" y="34" width="165" height="48" as="geometry"/></mxCell>
        <mxCell id="c_qt" value="&lt;b&gt;Qt GUI 工控上位机&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;产线操作看板&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11.5;" vertex="1" parent="box_l5_l6"><mxGeometry x="205" y="34" width="160" height="48" as="geometry"/></mxCell>
        <mxCell id="c_web" value="&lt;b&gt;Web Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;全景监控 / RequirementView&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11.5;" vertex="1" parent="box_l5_l6"><mxGeometry x="385" y="34" width="170" height="48" as="geometry"/></mxCell>
        <mxCell id="c_dev" value="&lt;b&gt;开发者调试客户端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B91C1C;&quot;&gt;强夺申请 / jog / IO 调试&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=11.5;" vertex="1" parent="box_l5_l6"><mxGeometry x="575" y="34" width="180" height="48" as="geometry"/></mxCell>
        <mxCell id="c_opcua" value="&lt;b&gt;OPC UA 外部系统&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748B;&quot;&gt;IEC 62541 设备交互&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11.5;" vertex="1" parent="box_l5_l6"><mxGeometry x="775" y="34" width="165" height="48" as="geometry"/></mxCell>
        <mxCell id="c_proto_bar" value="&lt;b&gt;API 接入协议网关层&lt;/b&gt;：HTTP REST (CRUD) ｜ WebSocket 事实订阅 ｜ OPC UA Server ｜ SiteProtocolAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontSize=11;fontColor=#475569;" vertex="1" parent="box_l5_l6"><mxGeometry x="960" y="34" width="490" height="48" as="geometry"/></mxCell>
        <mxCell id="box_mid" value="L4 MFMS 数据中台 (独立服务 · C++ 模块化单体 · 局域网小主机)" style="swimlane;html=1;startSize=28;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#1E40AF;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="1470" height="350" as="geometry"/></mxCell>
        <mxCell id="m_http" value="&lt;b&gt;HttpEndpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;REST API / 鉴权代理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="box_mid"><mxGeometry x="20" y="40" width="170" height="46" as="geometry"/></mxCell>
        <mxCell id="m_ws" value="&lt;b&gt;WebSocketEndpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;实时推送 / 状态广播&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="box_mid"><mxGeometry x="210" y="40" width="170" height="46" as="geometry"/></mxCell>
        <mxCell id="m_opc" value="&lt;b&gt;OpcUaServer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;IEC 62541 地址空间&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="box_mid"><mxGeometry x="400" y="40" width="170" height="46" as="geometry"/></mxCell>
        <mxCell id="m_proto_bridge" value="&lt;b&gt;SiteProtocolAdapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;工厂私有协议转换&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="box_mid"><mxGeometry x="590" y="40" width="170" height="46" as="geometry"/></mxCell>
        <mxCell id="m_gateway" value="&lt;b&gt;MfmsGateway 网关层&lt;/b&gt; (用户鉴权 · 风险提示 · requestId 生成注入 · 稳定 DTO 转换 · 异常错误码映射)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=11;fontColor=#92400E;" vertex="1" parent="box_mid"><mxGeometry x="20" y="98" width="1430" height="34" as="geometry"/></mxCell>
        <mxCell id="m_order_intake" value="&lt;b&gt;RequirementIntakeService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;需求合法性校验 / 单写 requirement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11.5;" vertex="1" parent="box_mid"><mxGeometry x="20" y="144" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="m_order_query" value="&lt;b&gt;RequirementQueryService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;只读聚合 RequirementView&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11.5;" vertex="1" parent="box_mid"><mxGeometry x="260" y="144" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="m_ctrl_acc" value="&lt;b&gt;ControlAccessService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B91C1C;&quot;&gt;强夺理由收集 / 透传申请 / 审计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=11.5;" vertex="1" parent="box_mid"><mxGeometry x="500" y="144" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="m_dbg_cmd" value="&lt;b&gt;DebugCommandService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#B91C1C;&quot;&gt;jog / navigate / robot / IO 调试&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=11.5;" vertex="1" parent="box_mid"><mxGeometry x="740" y="144" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="m_state_mgr" value="&lt;b&gt;StateManager 状态引擎&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#047857;&quot;&gt;Control/Device 快照 · 质量评估&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=11.5;" vertex="1" parent="box_mid"><mxGeometry x="980" y="144" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="m_db_serv" value="&lt;b&gt;PersistenceManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;MySQL 连接池 · 仓储管理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11.5;" vertex="1" parent="box_mid"><mxGeometry x="1220" y="144" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="m_stream_ingest" value="&lt;b&gt;RedisStreamIngestor&lt;/b&gt; (统一信封解码 ｜ Schema 版本校验 ｜ 来源序号检重保序 ｜ 质量标记 UNKNOWN/FRESH/STALE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=11;fontColor=#065F46;" vertex="1" parent="box_mid"><mxGeometry x="20" y="216" width="600" height="46" as="geometry"/></mxCell>
        <mxCell id="m_sdk_client" value="&lt;b&gt;LowerMachineClient (Cpp-Proxy-SDK 隔离薄层)&lt;/b&gt; ── QueryControl / Acquire / ForceAcquire / Release / cmd 指令透传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;fontSize=11;fontColor=#9F1239;" vertex="1" parent="box_mid"><mxGeometry x="640" y="216" width="810" height="46" as="geometry"/></mxCell>
        <mxCell id="m_forbid" value="&lt;b style=&quot;color:#B91C1C;&quot;&gt;【中台严禁实现 · 红线禁区】&lt;/b&gt; 控制权状态机 · 锁表/lease/token · 跨系统夺权事务 · 需求拆单 · 订单/运单写入或推进 · 调度选车与通用 DAG 引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.2;strokeDasharray=4 2;fontSize=11;fontColor=#881337;align=left;spacingLeft=15;" vertex="1" parent="box_mid"><mxGeometry x="20" y="274" width="1430" height="60" as="geometry"/></mxCell>
        <mxCell id="box_storage" value="异步解耦存储总线" style="swimlane;html=1;startSize=26;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=12;fontStyle=1;fontColor=#92400E;rounded=1;" vertex="1" parent="1"><mxGeometry x="1540" y="255" width="340" height="350" as="geometry"/></mxCell>
        <mxCell id="db_mysql" value="&lt;b style=&quot;font-size:13px;color:#92400E;&quot;&gt;MySQL 关系型数据库&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;mfms_requirement&lt;/b&gt; (中台单写)&lt;br&gt;&lt;b&gt;mfms_order&lt;/b&gt; (调度单写)&lt;br&gt;&lt;b&gt;mfms_waybill&lt;/b&gt; (调度单写)&lt;br&gt;&lt;b&gt;mfms_control_audit&lt;/b&gt; (中台审计)&lt;br&gt;血缘：requirement → order → waybill" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_storage"><mxGeometry x="20" y="38" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="db_redis" value="&lt;b style=&quot;font-size:13px;color:#065F46;&quot;&gt;Redis Stream 事实队列&lt;/b&gt;&lt;br&gt;&lt;hr&gt;· 下位机物理/控制事实 stream&lt;br&gt;· Adapter 运单执行事实 stream&lt;br&gt;· 统一信封 Envelope (时间/序号/质量)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="box_storage"><mxGeometry x="20" y="190" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="bus_order" value="🔵 【需求业务通道】 MySQL ── mfms_requirement (数据中台校验并单写；调度读取)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.8;fontSize=12;fontStyle=1;fontColor=#1E40AF;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="1840" height="40" as="geometry"/></mxCell>
        <mxCell id="bus_exec" value="🟣 【订单与运单通道】 MySQL ── mfms_order ＆ mfms_waybill (调度拆分并单写；中台只读)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.8;fontSize=12;fontStyle=1;fontColor=#6B21A8;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="1840" height="40" as="geometry"/></mxCell>
        <mxCell id="bus_ctrl" value="🔴 【控制访问与调试总线】 Cpp-Proxy-SDK / ADK ── QueryControl / Acquire / ForceAcquire / Release ＆ 实时指令 (jog / nav / IO / robot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#991B1B;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="1840" height="40" as="geometry"/></mxCell>
        <mxCell id="bus_stream" value="🟢 【Redis Stream 实时事实总线】 统一消息信封 ── AgvControl (控制权快照) ｜ SeerCtrlState (遥测) ｜ AgvOrderState (运单执行进度事实)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#065F46;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="785" width="1840" height="40" as="geometry"/></mxCell>
        <mxCell id="box_sched" value="L3 调度系统 (多实例集群 · 独立进程)" style="swimlane;html=1;startSize=28;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.8;fontSize=13;fontStyle=1;fontColor=#6B21A8;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="470" height="380" as="geometry"/></mxCell>
        <mxCell id="sc_claim" value="&lt;b&gt;RequirementClaimer (多实例认领)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;读取待处理需求 · claim/idempotency/failover 待调度评审&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" vertex="1" parent="box_sched"><mxGeometry x="15" y="48" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="sc_dag" value="&lt;b&gt;RequirementSplitter (需求拆分)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;单写 mfms_order 与 mfms_waybill · 保留完整血缘&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" vertex="1" parent="box_sched"><mxGeometry x="15" y="118" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="sc_agg" value="&lt;b&gt;OrderWaybillLifecycle (派生状态)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;维护订单/运单持久状态 · 中台只读显示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=11;" vertex="1" parent="box_sched"><mxGeometry x="15" y="188" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="sc_note" value="&lt;b&gt;【调度职责边界】&lt;/b&gt;&lt;br&gt;· 需求拆分、选车与 DAG 编排归调度&lt;br&gt;· 只读中台 requirement；单写 order/waybill&lt;br&gt;· 中台不介入调度选主与实例编排" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontSize=10.5;fontColor=#581C87;align=left;spacingLeft=12;" vertex="1" parent="box_sched"><mxGeometry x="15" y="260" width="440" height="105" as="geometry"/></mxCell>
        <mxCell id="box_adap" value="L2 Adapter (设备与运单适配层 · 独立进程)" style="swimlane;html=1;startSize=28;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.8;fontSize=13;fontStyle=1;fontColor=#15803D;rounded=1;" vertex="1" parent="1"><mxGeometry x="530" y="855" width="470" height="380" as="geometry"/></mxCell>
        <mxCell id="ad_step" value="&lt;b&gt;WaybillExecutor (运单接收)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;接收调度运单 · 维护 Adapter 本地执行生命周期&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="box_adap"><mxGeometry x="15" y="48" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="ad_adk" value="&lt;b&gt;AdkClient (ADK 驱动与生产控制)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;调 ADK 申请控制权 (AcquireControl) · 下发生产路径与动作&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="box_adap"><mxGeometry x="15" y="118" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="ad_pub" value="&lt;b&gt;OrderStatePublisher (运单事实发布)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;向 Stream 发布 AgvOrderState 信封 (进度% / 故障码 / 完成)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="box_adap"><mxGeometry x="15" y="188" width="440" height="56" as="geometry"/></mxCell>
        <mxCell id="ad_note" value="&lt;b&gt;【Adapter 职责边界】&lt;/b&gt;&lt;br&gt;· 生产控制权申请者&lt;br&gt;· 若被开发者强夺，由自身状态机重试或上报&lt;br&gt;· 内部状态机与重试恢复不属中台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontSize=10.5;fontColor=#14532D;align=left;spacingLeft=12;" vertex="1" parent="box_adap"><mxGeometry x="15" y="260" width="440" height="105" as="geometry"/></mxCell>
        <mxCell id="box_lower" value="L1 下位机核心 ｜ 唯一控制权权威与裁决者 (Lower Machine Core)" style="swimlane;html=1;startSize=28;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#9F1239;rounded=1;" vertex="1" parent="1"><mxGeometry x="1020" y="855" width="860" height="380" as="geometry"/></mxCell>
        <mxCell id="lw_auth" value="&lt;b&gt;ControlAuthorityArbitrator (真实控制权独占存储与原子裁决)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;独占存储持有者 (owner_ip / type / time) ｜ 原子裁决 Query / Acquire / ForceAcquire / Release ｜ 失效规则由下位机定义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=11;fontColor=#9F1239;" vertex="1" parent="box_lower"><mxGeometry x="15" y="48" width="830" height="56" as="geometry"/></mxCell>
