filters:
  and:
    - '!file.ext.contains("svg")'
    - '!file.ext.contains("png")'
    - '!file.ext.contains("jpg")'
    - '!file.ext.contains("jpeg")'
    - '!file.ext.contains("gif")'
    - '!file.ext.contains("webp")'
    - '!file.ext.contains("bmp")'
    - '!file.ext.contains("ico")'
properties:
  file.ext:
    displayName: 类型
  file.folder:
    displayName: 所在目录
  file.mtime:
    displayName: 修改时间
views:
  - type: table
    name: 全部笔记
    order:
      - file.name
      - file.ext
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
